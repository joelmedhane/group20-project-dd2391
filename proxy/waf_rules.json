        },
        {
            "name": "SQL_ELT_SLEEP",
            "type": "regex",
            "value": "\\belt\\s*\\([^\\r\\n]{0,150}\\bsleep\\s*\\(",
            "score": 5
        },
        {
            "name": "SQL_STACKED_STATEMENT",
            "type": "regex",
            "value": ";\\s*(?:select|declare|set|waitfor)\\b",
            "score": 5
        },
        {
            "name": "SQL_DBMS_LOCK_SLEEP",
            "type": "regex",
