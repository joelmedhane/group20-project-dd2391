        },
        {
            "name": "SQL_WAITFOR_DELAY",
            "type": "regex",
            "value": "\\bwaitfor\\s+delay\\b",
            "score": 5
        },
        {
            "name": "SQL_SLEEP_CONDITION",
            "type": "regex",
