{
    "blocking_threshold": 5,
    "rules": [
        {
            "name": "SELECT",
            "type": "word",
            "value": "select",
            "score": 1
        },
        {
            "name": "DELETE",
            "type": "word",
            "value": "delete",
            "score": 1
        },
        {
            "name": "UPDATE",
            "type": "word",
            "value": "update",
            "score": 1
        },
        {
            "name": "SELECT_FROM",
            "type": "keywords",
            "value": ["select", "from"],
            "score": 4
        },
        {
            "name": "UPDATE_SET",
            "type": "keywords",
            "value": ["update", "set"],
            "score": 4
        },
        {
            "name": "INSERT_INTO",
            "type": "keywords",
            "value": ["insert", "into"],
            "score": 5
        },
        {
            "name": "DELETE_FROM",
            "type": "keywords",
            "value": ["delete", "from"],
            "score": 4
        },
        {
            "name": "UNION_SELECT",
            "type": "keywords",
            "value": ["union", "select"],
            "score": 5
        },
        {
            "name": "DROP_TABLE",
            "type": "keywords",
            "value": ["drop", "table"],
            "score": 5
        },
        {
            "name": "SQL_BOOLEAN",
            "type": "regex",
            "value": "\\b(or|and)\\b\\s+[\\w'\"]+\\s*(=|>|<|>=|<=|!=|<>)\\s*[\\w'\"]+",
            "score": 5
        },  
        {
            "name": "SQL_LINE_COMMENT",
            "type": "comment",
            "value": "--",
            "score": 3
        },
        {
            "name": "SQL_BLOCK_COMMENT",
            "type": "comment",
            "value": "/*",
            "score": 3
        }
    ]
}